{"name": "good_arrow_and_pipe", "input": "a => b | c", "expected": "IDENT(a) OP_ARROW(=>) IDENT(b) OP_PIPE(|) IDENT(c)"}
{"name": "good_implication_chain", "input": "a -> b -> c", "expected": "IDENT(a) OP_IMPLIES(->) IDENT(b) OP_IMPLIES(->) IDENT(c)"}
{"name": "good_minus_gt_separated", "input": "x - >", "expected": "IDENT(x) OP_MINUS(-) OP_GT(>)"}
{"name": "good_comment_skipped", "input": "x = 1; // set x\ny = 2;", "expected": "IDENT(x) OP_ASSIGN(=) INT(1) OP_SEMI(;) IDENT(y) OP_ASSIGN(=) INT(2) OP_SEMI(;)"}
{"name": "good_comment_eof_no_newline", "input": "x = 1; // tail", "expected": "IDENT(x) OP_ASSIGN(=) INT(1) OP_SEMI(;)"}
{"name": "good_comment_only", "input": "//", "expected": ""}
{"name": "good_comment_crlf", "input": "a // c\r\nb", "expected": "IDENT(a) IDENT(b)"}
{"name": "good_comment_lone_cr", "input": "a // c\rb", "expected": "IDENT(a) IDENT(b)"}
{"name": "good_slash_vs_comment", "input": "a / b // c", "expected": "IDENT(a) OP_SLASH(/) IDENT(b)"}
{"name": "good_array_type", "input": "a: int[]", "expected": "IDENT(a) OP_COLON(:) KW_INT(int) OP_LBRACKET([) OP_RBRACKET(])"}
{"name": "good_array_access", "input": "a[i] = length(a);", "expected": "IDENT(a) OP_LBRACKET([) IDENT(i) OP_RBRACKET(]) OP_ASSIGN(=) KW_LENGTH(length) OP_LPAREN(() IDENT(a) OP_RPAREN()) OP_SEMI(;)"}
{"name": "good_quantifier", "input": "forall(i: int | i >= 0)", "expected": "KW_FORALL(forall) OP_LPAREN(() IDENT(i) OP_COLON(:) KW_INT(int) OP_PIPE(|) IDENT(i) OP_GE(>=) INT(0) OP_RPAREN())"}
{"name": "good_formula_def", "input": "pos(x: int) => x > 0", "expected": "IDENT(pos) OP_LPAREN(() IDENT(x) OP_COLON(:) KW_INT(int) OP_RPAREN()) OP_ARROW(=>) IDENT(x) OP_GT(>) INT(0)"}
{"name": "good_function_header", "input": "gcd(x: int, y: int)\n  returns r: int", "expected": "IDENT(gcd) OP_LPAREN(() IDENT(x) OP_COLON(:) KW_INT(int) OP_COMMA(,) IDENT(y) OP_COLON(:) KW_INT(int) OP_RPAREN()) KW_RETURNS(returns) IDENT(r) OP_COLON(:) KW_INT(int)"}
